    })

label plus_one2():
    Define.correct_answers += 1
    Lore.jump("menu3")

label none2():
    Lore.jump("menu3")

label menu3():
    <> "Как правильно?"
    Scene.show_menu({
        "ТвОрог" : "loading_menu",
        "ТворОг" : "loading_menu"
    })

label loading_menu():
    Define.correct_answers += 1

    <> "Итого..."

    ans = Define.correct_answers
    if ans == 3:
        Lore.jump("survey_program_correct")
    elif ans == 2:
        Lore.jump("survey_program_maybe_correct")
    else:
        Lore.jump("survey_program_uncorrect")


label survey_program_correct():
    <> "3/3!"
    <> "Ого, кажется, в этот раз многие дети решили взяться за голову. \n Интересно, почему… конец четверти?"
    Lore.jump("home_late_continue")

label survey_program_maybe_correct():
    <> "2/3!"
    <> "Что ж, бывает и лучше, конечно… но бывает и хуже. \n Есть ли вообще сейчас смысл выбирать между полупустым и полуполным стаканом?"
    Lore.jump("home_late_continue")

label survey_program_uncorrect():
    <> "1/3."
    <> "Это просто катастрофа. Час от часу не легче, одна работа хуже другой, сплошная головная боль…"
    Lore.jump("home_late_continue")


label home_late_continue():
    <> "Незаметно за столом возникла ещё одна личность. Она некоторое время понаблюдала за работой с ухмылкой, а потом внезапно спросила:"
    <oz> "Ну, как продвигается?~ "
    <> "Жаклин пробормотала что-то невнятное."
    <oz> "Есть положительные изменения или всё стабильно?"
    <shak> "Ну… у некоторых, очевидно, вообще ничего никогда не меняется. \n Ленивые заразы… как же я устала…"
    <oz> "Могу немного облегчить твои страдания~"
    <> "Она продемонстрировала какую-то чёрную склизкую креветку, неестественно переливающуюся на свету."
    <oz> "Хочешь запечатать в одну из работ и вспугнуть кого-нибудь?"
    <> "Жаклин вытаращилась на неё."
    <shak> "Ты издеваешься?.. Нет, я знаю, что ты любишь устраивать такие фокусы – к слову, незачем было подкладывать их мне в кошель – но это совсем выходит за границы. Я ещё не настолько-"
    <> "Ms. Ф.ОЗИНАД ловко выхватила один из листочков, взглянула на него с усмешкой и протянула Жаклин, подняв брови."
    <shak> "Вот эта джекушка полупокера буквально написала: «Я не готовилась, и что вы мне сделаете?»."
    <> "Жаклин вспыхнула и сжала челюсти, глядя на листок. Одно из её век дёрнулось, губы дрогнули, превращаясь в истеричную улыбку. Затем она подняла взгляд на собеседницу."
    <shak> "Нет, знаешь что… вперёд. Давай сюда свою мерзость."
    <shak> "Это была последняя капля, видит вселенная – я держалась до последнего. Запечатывай что хочешь, хуже уже не будет. Может, хотя бы раз я не увижу эту глупую улыбку на лице Джексон."
    <> "Ms. Ф.ОЗИНАД хихикнула, втирая существо в её руках в листок. Оно быстро растворилось в нём, сливаясь с чернилами."
    <oz> "Вот и треснула твоя выдержка, хе-хе~ Не парься, оно в любом случае заслуженно. Они там все бестолочи, а ты у нас главный недооценённый великомученик~"
    <> "Она дружески хлопнула подругу по плечу. Жаклин криво улыбнулась."
    <shak> "Иногда я задумываюсь, ради чего вообще пытаюсь, и есть ли в этом настолько много моей вины… а потом смотрю на тебя и понимаю, что, в целом, всё ещё неплохо."
    <oz> "Ну и супер! Ты давай держись, я жду твоих абсурдных историй с работы как вечернюю газету~"
    <shak> "Только благодаря тебе и держусь, Оз."
    Scene.set_scene("ewwwwwww.png", effect=SpriteEffects.Dissolve(1.0))
    <> "Она грустно улыбнулась и закрыла глаза, положив голову на плечо подруге."
    <shak> "Спасибо за понимание."
    <oz> "Спасибо на хлеб не намажешь~"
    <> "Жаклин слегка пихнула её, но улыбки на лицах леди никуда не исчезли."
    <shak> "Иногда ты невыносима, знаешь?"
    <oz> "И я тебя тоже, дорогая."
    end()

label home("Дом милый дом", "Это что за покемон?", show_splash = True, speed = 2):
    Scene.set_scene("home_hallway.jpg")
    Scene.show_character("shak usual", at="right")
    Audio.play("music", "ponos_deda_(remix).mp3", effect="fade", volume=0.5)
    Scene.fade("fadeout", 1)

    <> "В прихожую впорхнула леди в вычурном претенциозном наряде со смутными претензиями на готику."
    <> "Было удивительно, как вся эта чопорная одежда, покрывающая чуть ли не всё тело, не заставляла её выглядеть упаренной вусмерть."
    <> "Напротив, обладательница сего гардероба выглядела вполне жизнерадостно."
    <oz> "А ВОТ И МОЯ ЛЮБИМАЯ СОСЕДУШКАААА!~"
    <> "Жаклин устало поморщилась."
    Scene.show_character("shak angry")
    <shak> "Нельзя ли потише... "
    <oz> "А у меня для тебя сюрприз! Хочешь узнать, какой?~"
    <shak> "Я бы больше хотела, чтобы ты мне с пакетами помогла..."

    Scene.start_cutscene("strashilka_xodit.gif")
    wait(10.0)
    Scene.set_scene("home_hallway.jpg")

    Scene.show_character("shak angry")
    <shak> "...что это."
    <oz> "Это зайка)"
    Scene.show_character("shak usual")
    <shak> "Чт- какой зайка, где ты *это* подобрала?.."
    <oz> "С ПЕРВЫМ АПРЕЛЯ)))"
    <shak> "..."
    <oz> ")))"
    Scene.show_character("shak usual 1")
    <shak> "Оно хоть привито?"
    <oz> "Их не нужно прививать, я их достала прямиком из черничного моря ;3"
    <shak> "*вздох смирения* И где ты взяла это черничное море? Не дай боже снова заляпаешь комнату своими порталами, оттирать будешь сама."
    <oz> "Да неееее, я не- \n {w=1.0} ОХ БЛИН СПАСИБО ЧТО НАПОМНИЛА ЗАКРЫТЬ-"
    <shak> "Мгм, всегда пожалуйста"
    <oz> "Кто знает, какая дурь оттуда бы выползла, если б ты сейчас не сказала"
    <shak> "А ты разве не знаешь?"
    <oz> "...!"
    Scene.show_character("shak funny 2")
    <oz> "Окей, в этот раз подловила"
    <shak> "Это не то что бы сложно. Пошли, расскажешь мне об этой штуке, пока я что-нибудь нам состряпаю."
    Scene.set_scene("home_kitchen.jpg", effect=SpriteEffects.Dissolve(1.0))

    Scene.show_character("shak funny 1", effect=SpriteEffects.Dissolve(1.0))
    <oz> "Ну-с, что собираешься устроить?~"
    <shak> "Ну... из того, что сейчас под рукой, можно по-быстрому приготовить..."
    Scene.set_scene("home_hallway.jpg")

    if "puki.png" in Define.collected_items and "milk.png" in Define.collected_items and "eggs.png" in Define.collected_items:
        Lore.jump("sorry")
    elif "milk.png" in Define.collected_items and "eggs.png" in Define.collected_items:
        Lore.jump("cooking_omlet")
    else:
        Lore.jump("sorry")

    Lore.jump("cooking_omlet")



###### > Омлет
label cooking_omlet():
    Scene.show_character("shak usual 1", at="right", effect=SpriteEffects.Dissolve(1.0))
    <> "Жаклин начала смешивать смесь яиц и молока в миске."
    <oz> "Так что готовишь-то?"
    <shak> "Запечённую курицу."
    <oz> "А если серьёзно?"
    Scene.show_character("shak usual")
    <shak> "Тогда блины."
    <oz> "Что-то непохоже."
    Scene.show_character("shak funny 3")
    <shak> "Ты много блинов в своей жизни сделала?"
    <oz> "Да не то что бы- стой, не переводи тему!"
    <shak> "Ну так вот я в этой теме всё-таки немного поопытнее... и я говорю, что это будут блины. Сейчас буду жарить."
    <oz> "А муку кто добавлять будет?"
    Scene.show_character("shak usual 1")
    <> "Жаклин сдержала в горле подступивший смешок, напустив на себя серьёзное выражение лица."
    <shak> "Этот рецепт называется \"панкейки без муки\", Ози."
    <oz> "Да это же не блины никакие, а клятучий омлет! В блинах обязательно должна быть мука!"
    <shak> "А панкейки это ещё и оладьи..."
    <> "ОЗИНАД на секунду остановилась, то ли потеряв дар речи, то ли пытаясь прочитать мысли кулинарного гения местного разлива."
    <oz> "В оладьях тоже нужна мука, ты поехавшая!..."
    Scene.show_character("shak funny 2")
    <shak> "Ну так я повторюсь, это в любом случае рецепт \"панкейки без муки\", он даже называется так, специально для таких, как ты~"
    <oz> "ПАНКЕЙКИ БЕЗ МУКИ ЭТО СРАНЫЙ ОМЛЕТ-"
    <> "УГАШЕННЫЙ ТЫ ОБ ДЕРЕВО"
    Scene.show_character("shak funny 3")
    <> "Дамы от души рассмеялись в унисон."
    Scene.show_character("shak funny 1")
    <shak> "Спасибо, что подыграла~"
    <oz> "Буду честна, в начале я действительно подумала, что у тебя начала течь крыша, но потом пришло осознание."
    <oz> "И как ты вообще могла так шутить со мной, ах..."
    <shak> "То есть когда ты меняешь берёзовый сок на уксус, это окей, а когда я меняю местами понятия, это катастрофа?"
    <oz> "Твоё лицо того стоило~"
    Scene.show_character("shak funny 2")
    <shak> "Твоё тоже~"
    <> "Жаклин тихо хихикнула под нос, накрывая сковороду с омлетом крышкой."
    <shak> "И, раз уж начистоту, есть что-то особенное в том, чтобы перехитрить такую чертилу, как ты~"
    <oz> "Да ты чтооооо! Вот это ты великомученица, страдальчески терпишь такую страшную бесовщина!"
    <shak> "Хех... Да и не то что бы я особенно страшно страдала с этой \"страшной бесовщиной\"."
    <oz> "Почему же?"
    Scene.show_character("shak confused")
    <shak> "Потому что ты моя бесовщина~"
    end()

    #[[Концовка: Омлет без муки]]


